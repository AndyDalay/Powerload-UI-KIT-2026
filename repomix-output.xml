  width: 100%;
  height: 40px;
  padding: 8px 20px;
  border: 1.5px solid var(--pl-n400);
  border-radius: 9999px;
  background: transparent;
  color: var(--pl-n600);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition:
    background-color 150ms ease,
    border-color 150ms ease;
