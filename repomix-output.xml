// ─── Helpers ──────────────────────────────────────────────────────────────────
function slugify(name: string) {
  return name
    .replace(/([A-Z])/g, (m, c, i) => (i > 0 ? " " : "") + c)
    .replace(/\s+/g, " ")
    .trim();
}

